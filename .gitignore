# ==========================================
# .gitignore dla Systemu Redukcji Hybrydowej
# ==========================================

# 1. Œrodowisko Python i pliki tymczasowe
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.env

# 2. C++ / CUDA / CMake (Kompilacja)
build/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
*.out
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib

# 3. Pliki specyficzne dla tego projektu (Zgodnie ze specyfikacj¹)
temp_workspace/*
!temp_workspace/.gitkeep

results/*
!results/.gitkeep

# Ignoruj wygenerowane pliki binarne z danymi, niezale¿nie gdzie s¹
*.bin

# 4. Pliki edytorów i systemów operacyjnych (IDE / OS)
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db